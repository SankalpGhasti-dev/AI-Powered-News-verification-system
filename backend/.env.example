# TruthLens Backend Environment Configuration
# Copy this file to .env and configure your actual API keys.
# NEVER commit your actual .env file to version control.

# Google Gemini API Key (for factual claim extraction and explanation synthesis)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GNews API Key (for related news reporting retrieval)
# Obtain at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# Google Fact Check Tools API Key (for verified fact-checks)
# Obtain at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
FACTCHECK_API_KEY=your_factcheck_api_key_here

# Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Allowed Frontend Origins (comma-separated list for CORS)
# Update this with your frontend port (e.g., Live Server on 5500, Vite on 5173, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:5500,http://127.0.0.1:3000,http://127.0.0.1:8000,http://127.0.0.1:8080

# Processing Limits
MAX_ARTICLE_CHARS=50000
ARTICLE_FETCH_TIMEOUT_SECONDS=8
MAX_ARTICLE_DOWNLOAD_BYTES=3145728
